configuration {
  modi: "drun,run,window";
  show-icons: true;
  display-drun: "apps";
  drun-display-format: "{name}";
  font: "JetBrains Mono Nerd Font 12";
}

* {
  bg: #0f1419f2;
  bg-alt: #161b22ff;
  bg-card: #1a2130ff;
  fg: #e5e9f0ff;
  fg-dim: #8b949eff;
  accent: #88c0d0ff;
  border: #2e3440ff;
  urgent: #ff7b72ff;
}

window {
  width: 420px;
  border: 2px;
  border-color: @accent;
  border-radius: 0;
  background-color: @bg;
  padding: 12px;
  location: center;
  anchor: center;
  children: [ mainbox ];
}

mainbox {
  background-color: transparent;
  spacing: 10px;
  children: [ inputbar, message, listview ];
}

inputbar {
  background-color: @bg-alt;
  border: 1px;
  border-color: @border;
  border-radius: 0;
  padding: 10px 12px;
  spacing: 8px;
  children: [ prompt, entry ];
}

prompt {
  background-color: transparent;
  text-color: @accent;
  font: "JetBrains Mono Nerd Font Bold 12";
}

entry {
  background-color: transparent;
  text-color: @fg;
  placeholder: "search…";
  placeholder-color: @fg-dim;
  cursor: text;
}

message {
  background-color: transparent;
  text-color: @fg-dim;
  padding: 2px;
}

listview {
  background-color: transparent;
  lines: 8;
  columns: 1;
  spacing: 5px;
  fixed-height: true;
  scrollbar: false;
  flow: vertical;
}

element {
  background-color: @bg-card;
  padding: 9px 11px;
  border-radius: 0;
  border: 1px;
  border-color: transparent;
  spacing: 10px;
}

element normal normal {
  text-color: @fg;
  background-color: @bg-card;
}

element alternate normal {
  text-color: @fg;
  background-color: @bg-alt;
}

element selected normal {
  background-color: #1c3244;
  text-color: @accent;
  border-color: @accent;
}

element selected alternate {
  background-color: #1c3244;
  text-color: @accent;
  border-color: @accent;
}

element-icon {
  background-color: transparent;
  size: 24px;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
  font: "JetBrains Mono Nerd Font 12";
}
