{
  "layer": "top",
  "position": "right",
  "width": 56,
  "height": "100%",
  "margin": "6px 6px 6px 0",
  "padding": "10px 4px",
  "spacing": 6,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/launcher",
    "custom/workspace",
    "clock",
    "cpu",
    "memory"
  ],
  "modules-center": [
    "pulseaudio",
    "backlight",
    "network",
    "battery"
  ],
  "modules-right": [
    "custom/notifications",
    "custom/settings",
    "custom/session"
  ],
  "custom/launcher": {
    "format": "󰣃",
    "tooltip": true,
    "tooltip-format": "mino utilities",
    "on-click": "/home/cerie/.config/hypr/scripts/mino-menu.sh",
    "on-click-right": "rofi -show drun -theme mino"
  },
  "custom/workspace": {
    "exec": "/home/cerie/.config/hypr/scripts/waybar-workspace.sh",
    "interval": 1,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "workspace · click next",
    "on-click": "hyprctl dispatch workspace e+1",
    "on-click-right": "hyprctl dispatch workspace e-1"
  },
  "clock": {
    "format": "{:%H%n%M}",
    "format-alt": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "{:%A\n%B %d, %Y}\n\n{calendar}",
    "interval": 30,
    "on-click": "",
    "on-click-right": "",
    "calendar": {
      "mode": "month",
      "mode-month": "month",
      "weeks-pos": "right",
      "format": {
        "months": "<span color='#88c0d0'><b>{}</b></span>",
        "days": "<span color='#e5e9f0'>{}</span>",
        "weeks": "<span color='#8b949e'>W{}</span>",
        "today": "<span color='#0f1419' background='#88c0d0'><b>{}</b></span>"
      }
    }
  },
  "cpu": {
    "format": "󰻠",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "CPU {usage}%"
  },
  "memory": {
    "format": "󰍛",
    "interval": 3,
    "tooltip": true,
    "tooltip-format": "RAM {percentage}% - {used} / {total}"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 5,
    "on-click": "/home/cerie/.config/hypr/scripts/volume-slider.sh",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip": true,
    "tooltip-format": "{volume}% | click for slider | scroll adjusts"
  },
  "backlight": {
    "format": "󰃠",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "on-click": "/home/cerie/.config/hypr/scripts/brightness-slider.sh",
    "tooltip": true,
    "tooltip-format": "Brightness {percent}% · min 1%"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}\nclick to manage",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "disconnected | click to connect",
    "on-click": "/home/cerie/.config/hypr/scripts/network-menu.sh",
    "on-click-right": "nm-connection-editor || nmtui",
    "max-length": 20
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-full": "󰁹",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{capacity}% - {timeTo}",
    "on-click": ""
  },
  "custom/notifications": {
    "format": "󰂚",
    "tooltip": true,
    "tooltip-format": "Notifications",
    "on-click": "makoctl dismiss -a",
    "on-click-right": "makoctl restore",
    "on-click-middle": "makoctl mode -t dnd || true"
  },
  "custom/settings": {
    "format": "󰒓",
    "tooltip": true,
    "tooltip-format": "Settings",
    "on-click": "/home/cerie/.config/hypr/scripts/settings.sh"
  },
  "custom/session": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Session",
    "on-click": "/home/cerie/.config/hypr/scripts/session-menu.sh",
    "on-click-right": "hyprlock"
  }
}
