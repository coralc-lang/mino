{
  "layer": "top",
  "position": "right",
  "width": 56,
  "height": "100%",
  "margin": "4px 4px 4px 0",
  "padding": "8px 3px",
  "spacing": 4,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/launcher",
    "custom/workspace",
    "clock",
    "cpu",
    "memory"
  ],
  "modules-center": [
    "pulseaudio",
    "network",
    "battery"
  ],
  "modules-right": [
    "custom/notifications",
    "custom/settings",
    "custom/session"
  ],
  "custom/launcher": {
    "format": "󰣃",
    "tooltip": true,
    "tooltip-format": "mino",
    "on-click": "",
    "on-click-right": ""
  },
  "custom/workspace": {
    "exec": "/home/cerie/.config/hypr/scripts/waybar-workspace.sh",
    "interval": 1,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "workspace",
    "on-click": "hyprctl dispatch workspace e+1",
    "on-click-right": "hyprctl dispatch workspace e-1"
  },
  "clock": {
    "format": "{:%H\\n%M}",
    "format-alt": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "interval": 30,
    "on-click": "",
    "on-click-right": ""
  },
  "cpu": {
    "format": "󰻠",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "CPU {usage}%"
  },
  "memory": {
    "format": "󰍛",
    "interval": 3,
    "tooltip": true,
    "tooltip-format": "RAM {percentage}% — {used} / {total}"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 5,
    "on-click": "/home/cerie/.config/hypr/scripts/volume-menu.sh",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
    "tooltip": true,
    "tooltip-format": "{volume}% — scroll to adjust"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "disconnected",
    "on-click": "nm-connection-editor || nmtui",
    "max-length": 20
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-full": "󰁹",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{capacity}% — {timeTo}",
    "on-click": ""
  },
  "custom/notifications": {
    "format": "󰂚",
    "tooltip": true,
    "tooltip-format": "Notifications",
    "on-click": "makoctl dismiss -a",
    "on-click-right": "makoctl restore",
    "on-click-middle": "makoctl mode -t dnd || true"
  },
  "custom/settings": {
    "format": "󰒓",
    "tooltip": true,
    "tooltip-format": "Settings",
    "on-click": "/home/cerie/.config/hypr/scripts/settings.sh"
  },
  "custom/session": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Session",
    "on-click": "/home/cerie/.config/hypr/scripts/session-menu.sh",
    "on-click-right": "hyprlock"
  }
}
